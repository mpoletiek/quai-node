diff --git a/common/fdlimit/fdlimit_darwin.go b/common/fdlimit/fdlimit_darwin.go
index 6b26fa0..6e7dfe5 100644
--- a/common/fdlimit/fdlimit_darwin.go
+++ b/common/fdlimit/fdlimit_darwin.go
@@ -18,7 +18,8 @@ package fdlimit
 
 import "syscall"
 
-// hardlimit is the number of file descriptors allowed at max by the kernel.
+// hardlimit is the number of file descriptors allowed at max by the kernel,
+// when kern.maxfilesperproc can't be read.
 const hardlimit = 10240
 
 // Raise tries to maximize the file descriptor allowance of this process
@@ -63,9 +64,15 @@ func Maximum() (int, error) {
 	if err := syscall.Getrlimit(syscall.RLIMIT_NOFILE, &limit); err != nil {
 		return 0, err
 	}
-	// Cap it to OPEN_MAX (10240) because macos is a special snowflake
-	if limit.Max > hardlimit {
-		limit.Max = hardlimit
+	// Cap it to kern.maxfilesperproc, the most macOS lets one process open,
+	// as Go's runtime does. OPEN_MAX (10240) is far lower, and three or more
+	// chain databases outgrow it.
+	most := uint64(hardlimit)
+	if n, err := syscall.SysctlUint32("kern.maxfilesperproc"); err == nil && n > 0 {
+		most = uint64(n)
+	}
+	if limit.Max > most {
+		limit.Max = most
 	}
 	return int(limit.Max), nil
 }
